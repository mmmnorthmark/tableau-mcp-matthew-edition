# Multi-Instance Tableau Search MCP Server Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# TABLEAU INSTANCES CONFIGURATION
# =============================================================================
# JSON array of Tableau instances to search across
# Each instance must have: name, server, auth, and appropriate credentials
TABLEAU_INSTANCES='[
  {
    "name": "production",
    "server": "https://tableau.company.com",
    "siteName": "",
    "auth": "pat",
    "patName": "search-service",
    "patValue": "your-production-pat-token",
    "enabled": true,
    "priority": 10,
    "maxConcurrentRequests": 15,
    "requestTimeout": 30000
  },
  {
    "name": "staging",
    "server": "https://tableau-staging.company.com",
    "siteName": "",
    "auth": "pat",
    "patName": "search-service",
    "patValue": "your-staging-pat-token",
    "enabled": true,
    "priority": 5,
    "maxConcurrentRequests": 10,
    "requestTimeout": 30000
  },
  {
    "name": "cloud",
    "server": "https://prod-ap-southeast-2a.online.tableau.com",
    "siteName": "",
    "auth": "direct-trust",
    "jwtSubClaim": "search-service@company.com",
    "connectedAppClientId": "your-client-id",
    "connectedAppSecretId": "your-secret-id",
    "connectedAppSecretValue": "your-secret-value",
    "jwtAdditionalPayload": "{\"groups\":[\"tableau-search-users\"]}",
    "enabled": true,
    "priority": 8,
    "maxConcurrentRequests": 12,
    "requestTimeout": 45000
  }
]'

# =============================================================================
# SEARCH CONFIGURATION
# =============================================================================
# Cache TTL in milliseconds (default: 300000 = 5 minutes)
SEARCH_CACHE_TTL=300000

# Maximum concurrent searches across instances (default: 10)
MAX_CONCURRENT_SEARCHES=15

# Search timeout in milliseconds (default: 30000 = 30 seconds)
SEARCH_TIMEOUT=45000

# Enable request-level caching (default: true)
ENABLE_REQUEST_CACHING=true

# Custom system prompt for result prioritization
SYSTEM_PROMPT="Prioritize results based on relevance to the user query, content freshness, and usage popularity. Production instances should be weighted higher than staging instances."

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Transport method: stdio, http, or docker
TRANSPORT=stdio

# Default log level: debug, info, warn, error
DEFAULT_LOG_LEVEL=info

# Disable log masking (default: false)
DISABLE_LOG_MASKING=false

# Include specific tools (comma-separated, optional)
# INCLUDE_TOOLS=search-content,list-workbooks,list-views

# Exclude specific tools (comma-separated, optional)
# EXCLUDE_TOOLS=list-datasources,query-datasource

# Maximum results per query (optional)
# MAX_RESULT_LIMIT=100

# =============================================================================
# HTTP SERVER CONFIGURATION (when TRANSPORT=http)
# =============================================================================
# HTTP port (default: 3927)
# HTTP_PORT=3927

# CORS origin configuration
# CORS_ORIGIN_CONFIG=*

# SSL configuration (optional)
# SSL_KEY=/path/to/ssl.key
# SSL_CERT=/path/to/ssl.cert

# =============================================================================
# LEGACY SINGLE-INSTANCE CONFIGURATION (for backward compatibility)
# =============================================================================
# If TABLEAU_INSTANCES is not set, the server will use these legacy variables
# SERVER=https://tableau.company.com
# SITE_NAME=
# AUTH=pat
# PAT_NAME=search-service
# PAT_VALUE=your-pat-token
# JWT_SUB_CLAIM=search-service@company.com
# CONNECTED_APP_CLIENT_ID=your-client-id
# CONNECTED_APP_SECRET_ID=your-secret-id
# CONNECTED_APP_SECRET_VALUE=your-secret-value
# JWT_ADDITIONAL_PAYLOAD={}
# DATASOURCE_CREDENTIALS=
